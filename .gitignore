# Datasets — never push to a public repo
*.h5ad
*.h5
*.loom
*.csv.gz
*.mtx
*.tsv.gz

# Build / projection caches — they embed expression matrices
cache/
*.pkl

# Large binary blobs — ignored by default so stray/regenerated shards don't
# silently bloat the repo. EXCEPTION: the Zhuang spatial MERFISH shards are
# deployment artifacts that GitHub Pages serves directly, so keep them tracked.
*.bin
!spatial_zhuang/data/*.bin

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
